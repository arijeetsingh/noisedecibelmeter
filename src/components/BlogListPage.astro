---
import Layout from '../layouts/Layout.astro';
import type { Translations } from '../i18n/en';
import type { CollectionEntry } from 'astro:content';

interface Props {
  t: Translations;
  lang?: string;
  posts: CollectionEntry<'blog'>[];
}
const { t, lang = 'en', posts } = Astro.props;
const bl = t.blog;
const prefix = lang === 'en' ? '' : `/${lang}`;
const canonicalUrl = lang === 'en'
  ? 'https://noisedecibelmeter.com/blog/'
  : `https://noisedecibelmeter.com/${lang}/blog/`;

const dateFormatter = new Intl.DateTimeFormat(t.htmlLang, { year: 'numeric', month: 'long', day: 'numeric' });
---

<style>
  html[data-dark] .page-title  { color: #f2f2f2 !important; }
  html[data-dark] .page-body   { color: #b0b0b0 !important; }
  html[data-dark] .post-card   { background: #1a1a1a !important; border-color: #272727 !important; }
  html[data-dark] .post-title  { color: #f2f2f2 !important; }
  html[data-dark] .post-desc   { color: #b0b0b0 !important; }
  html[data-dark] .post-date   { color: #888 !important; }
</style>

<Layout title={bl.title} description={bl.description} canonicalUrl={canonicalUrl} lang={lang} pagePath="blog" ogLocale={t.ogLocale}>
  <main style="max-width:720px;margin:0 auto;padding:64px 24px 96px;">

    <p style="font-family:'JetBrains Mono',monospace;font-size:11px;color:#888;text-transform:uppercase;letter-spacing:0.12em;margin:0 0 16px;">{bl.label}</p>
    <h1 class="page-title" style="font-size:40px;font-weight:600;color:#171717;letter-spacing:-1.8px;line-height:1.1;margin:0 0 20px;">{bl.h1}</h1>
    <p class="page-body" style="font-size:17px;color:#4d4d4d;line-height:1.75;margin:0 0 48px;">{bl.intro}</p>

    {posts.length === 0 ? (
      <p class="page-body" style="font-size:16px;color:#4d4d4d;">{bl.empty}</p>
    ) : (
      <div style="display:flex;flex-direction:column;gap:16px;">
        {posts.map(post => (
          <a href={`${prefix}/blog/${post.id.split('/').slice(1).join('/')}/`} class="post-card" style="display:block;background:#fff;border:1px solid #ebebeb;border-radius:12px;padding:24px;text-decoration:none;transition:border-color 0.15s;">
            <div class="post-date" style="font-family:'JetBrains Mono',monospace;font-size:11px;color:#888;text-transform:uppercase;letter-spacing:0.08em;margin-bottom:8px;">
              {dateFormatter.format(post.data.date)}
            </div>
            <div class="post-title" style="font-size:19px;font-weight:600;color:#171717;letter-spacing:-0.4px;margin-bottom:8px;">{post.data.title}</div>
            <div class="post-desc" style="font-size:14px;color:#4d4d4d;line-height:1.6;">{post.data.description}</div>
          </a>
        ))}
      </div>
    )}

  </main>
</Layout>
