---
import { getCollection } from 'astro:content';
import BlogListPage from '../../../components/BlogListPage.astro';
import { getTranslations, LOCALES } from '../../../i18n/index';

export function getStaticPaths() {
  return LOCALES.map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = getTranslations(lang);
const allPosts = await getCollection('blog', ({ id, data }) => id.startsWith(`${lang}/`) && !data.draft);
const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BlogListPage t={t} lang={lang} posts={posts} />
