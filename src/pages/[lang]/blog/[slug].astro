---
import { getCollection } from 'astro:content';
import BlogPostPage from '../../../components/BlogPostPage.astro';
import { getTranslations, LOCALES } from '../../../i18n/index';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts
    .filter(entry => LOCALES.includes(entry.id.split('/')[0] as typeof LOCALES[number]))
    .map(entry => {
      const [lang, ...rest] = entry.id.split('/');
      return {
        params: { lang, slug: rest.join('/') },
        props: { entry },
      };
    });
}

const { entry } = Astro.props;
const { lang, slug } = Astro.params;
const t = getTranslations(lang);
---
<BlogPostPage t={t} lang={lang} entry={entry} slug={slug} />
