---
import { getCollection } from 'astro:content';
import BlogPostPage from '../../components/BlogPostPage.astro';
import { getTranslations } from '../../i18n/index';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ id, data }) => id.startsWith('en/') && !data.draft);
  return posts.map(entry => ({
    params: { slug: entry.id.split('/').slice(1).join('/') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { slug } = Astro.params;
const t = getTranslations('en');
---
<BlogPostPage t={t} lang="en" entry={entry} slug={slug} />
